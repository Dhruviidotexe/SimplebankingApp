                        <div class=\"absolute right-6 top-1/2 -translate-y-1/2 pointer-events-none opacity-30\" data-kid=\"1-2-3-1-2-2-1-2-2\" data-name=\"dropdown chevron icon\">\n                                    <i class=\"ti ti-chevron-down text-2xl\" data-kid=\"1-2-3-1-2-2-1-2-2-1\" data-name=\"chevron icon\">\n                                    </i>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"relative group cursor-pointer\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"file upload input wrapper\">\n                            <input class=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"hidden file upload input\" id=\"file-upload\" type=\"file\"/>\n                            <div class=\"border-4 border-dashed border-slate-100 group-hover:border-[#7DF9FF]/30 rounded-[2.5rem] p-12 flex flex-col items-center justify-center gap-6 bg-slate-50 group-hover:bg-[#7DF9FF]/5 transition-all\" data-kid=\"1-2-3-1-2-2-2-2\" data-name=\"drag and drop visual area\">\n                                <div class=\"w-20 h-20 rounded-3xl bg-white shadow-lg flex items-center justify-center text-[#7DF9FF] group-hover:scale-110 transition-transform\" data-kid=\"1-2-3-1-2-2-2-2-1\" data-name=\"upload icon wrapper\">\n                                    <i class=\"ti ti-upload text-4xl\" data-kid=\"1-2-3-1-2-2-2-2-1-1\" data-name=\"upload cloud icon\">\n                                    </i>\n                                </div>\n                                <div class=\"text-center\" data-kid=\"1-2-3-1-2-2-2-2-2\" data-name=\"upload text container\">\n                                    <p class=\"text-xl font-extrabold text-[#003262]\" data-kid=\"1-2-3-1-2-2-2-2-2-1\" data-name=\"upload primary text\">\n                                        Drop your file here\n                                    </p>\n                                    <p class=\"text-sm font-medium text-slate-400 mt-1\" data-kid=\"1-2-3-1-2-2-2-2-2-2\" data-name=\"upload secondary text\">\n                                        or browse from your device\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-3-1-2-2-3\" data-name=\"saved documents list\">\n                            <p class=\"text-xs font-black text-[#003262]/30 uppercase tracking-[0.2em] mb-4 ml-1\" data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"saved documents label\">\n                                Saved documents (2)\n                            </p>\n                            <div class=\"flex flex-wrap gap-3\" data-kid=\"1-2-3-1-2-2-3-2\" data-name=\"saved documents files container\">\n                                <div class=\"px-5 py-3 bg-[#7DF9FF]/10 text-[#003262] text-sm font-black rounded-2xl border border-[#7DF9FF]/20 flex items-center gap-3 group/doc hover:bg-[#7DF9FF]/20 transition-all cursor-default\" data-kid=\"1-2-3-1-2-2-3-2-1\" data-name=\"aadhaar document file chip\">\n                                    <i class=\"ti ti-file-text text-lg\" data-kid=\"1-2-3-1-2-2-3-2-1-1\" data-name=\"file icon\">\n                                    </i>\n                                    <span data-kid=\"1-2-3-1-2-2-3-2-1-2\" data-name=\"file name text\">\n                                        aadhaar_front.jpg\n                                    </span>\n                                    <i class=\"ti ti-x text-base opacity-30 hover:opacity-100 hover:text-red-500 cursor-pointer transition-all\" data-kid=\"1-2-3-1-2-2-3-2-1-3\" data-name=\"remove file button\">\n                                    </i>\n                                </div>\n                                <div class=\"px-5 py-3 bg-[#7DF9FF]/10 text-[#003262] text-sm font-black rounded-2xl border border-[#7DF9FF]/20 flex items-center gap-3 group/doc hover:bg-[#7DF9FF]/20 transition-all cursor-default\" data-kid=\"1-2-3-1-2-2-3-2-2\" data-name=\"pan card document file chip\">\n                                    <i class=\"ti ti-file-shield text-lg\" data-kid=\"1-2-3-1-2-2-3-2-2-1\" data-name=\"shield file icon\">\n                                    </i>\n                                    <span data-kid=\"1-2-3-1-2-2-3-2-2-2\" data-name=\"file name text\">\n                                        pan_card.pdf\n                                    </span>\n                                    <i class=\"ti ti-x text-base opacity-30 hover:opacity-100 hover:text-red-500 cursor-pointer transition-all\" data-kid=\"1-2-3-1-2-2-3-2-2-3\" data-name=\"remove file button\">\n                                    </i>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"w-full bg-[#003262] text-white py-5 rounded-[1.5rem] font-black text-xl shadow-2xl shadow-[#003262]/20 hover:scale-[1.01] active:scale-[0.99] transition-all\" data-kid=\"1-2-3-1-2-2-4\" data-name=\"submit kyc form button\" type=\"submit\">\n                            Submit for Review\n                        </button>\n                    </form>\n                </div>\n            </div>\n        </section>\n    </main>\n    <!-- Footer -->\n    <footer class=\"mt-8 py-12 border-t border-white/5 bg-[#002850]\" data-kid=\"1-3\" data-name=\"footer container\">\n        <div class=\"max-w-7xl mx-auto px-6 text-center space-y-4\" data-kid=\"1-3-1\" data-name=\"footer content wrapper\">\n            <div class=\"flex items-center justify-center gap-2 opacity-70 grayscale hover:grayscale-0 transition-all cursor-pointer\" data-kid=\"1-3-1-1\" data-name=\"footer logo container\">\n                <i class=\"ti ti-building-bank text-xl\" data-kid=\"1-3-1-1-1\" data-name=\"bank building icon\">\n                </i>\n                <span class=\"text-lg font-['Plus_Jakarta_Sans'] font-extrabold\" data-kid=\"1-3-1-1-2\" data-name=\"bank name text\">\n                    ABC BANK\n                </span>\n            </div>\n            <p class=\"text-white/50 text-sm font-medium tracking-wide\" data-kid=\"1-3-1-2\" data-name=\"copyright notice text\">\n                © 2026 ABC Bank. Educational Project.\n            </p>\n            <div class=\"flex justify-center gap-8 pt-4\" data-kid=\"1-3-1-3\" data-name=\"social media links container\">\n                <a class=\"text-white/40 hover:text-[#7DF9FF] transition-colors\" data-kid=\"1-3-1-3-1\" data-name=\"twitter link\" href=\"#\">\n                    <i class=\"ti ti-brand-twitter text-xl\" data-kid=\"1-3-1-3-1-1\" data-name=\"twitter icon\">\n                    </i>\n                </a>\n                <a class=\"text-white/40 hover:text-[#7DF9FF] transition-colors\" data-kid=\"1-3-1-3-2\" data-name=\"linkedin link\" href=\"#\">\n                    <i class=\"ti ti-brand-linkedin text-xl\" data-kid=\"1-3-1-3-2-1\" data-name=\"linkedin icon\">\n                    </i>\n                </a>\n                <a class=\"text-white/40 hover:text-[#7DF9FF] transition-colors\" data-kid=\"1-3-1-3-3\" data-name=\"github link\" href=\"#\">\n                    <i class=\"ti ti-brand-github text-xl\" data-kid=\"1-3-1-3-3-1\" data-name=\"github icon\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </footer>\n    <!-- Notification Stack -->\n    <div class=\"fixed top-8 left-1/2 -translate-x-1/2 z-[100] flex flex-col gap-3 w-full max-w-sm pointer-events-none px-4\" data-dynamic=\"true\" data-kid=\"1-4\" data-name=\"notification stack container\" data-reason=\"notifications are injected into this container by JS on actions\" id=\"notification-stack\">\n        <!-- Notifications injected here by JS -->\n    </div>\n</div>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n    width: 8px;\n}\n::-webkit-scrollbar-track {\n    background: #003262;\n}\n::-webkit-scrollbar-thumb {\n    background: rgba(255,255,255,0.1);\n    border-radius: 10px;\n}\n::-webkit-scrollbar-thumb:hover {\n    background: rgba(125,249,255,0.3);\n}\n\n.tab-btn.active {\n    background-color: #7DF9FF;\n    color: #003262;\n}\n\n/* Chrome, Safari, Edge, Opera */\ninput::-webkit-outer-spin-button,\ninput::-webkit-inner-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\n\n/* Firefox */\ninput[type=number] {\n  -moz-appearance: textfield;\n}\n</style>\n<!-- JS Libraries -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import { animate } from 'https://esm.sh/animejs@4';\n  window.anime = animate;\n</script>\n<script>\n    // Tab switching logic\n    function showTab(tabId) {\n        // Update tab buttons\n        document.querySelectorAll('.tab-btn').forEach(btn => {\n            btn.classList.remove('bg-[#7DF9FF]', 'text-[#003262]');\n            btn.classList.add('text-white/60');\n        });\n        const activeBtn = document.getElementById(`tab-${tabId}`);\n        activeBtn.classList.add('bg-[#7DF9FF]', 'text-[#003262]');\n        activeBtn.classList.remove('text-white/60');\n\n        // Switch content with simple fade\n        document.querySelectorAll('.tab-content').forEach(content => {\n            content.classList.add('hidden');\n        });\n        const activeContent = document.getElementById(`content-${tabId}`);\n        activeContent.classList.remove('hidden');\n\n        // Re-run animations for the active tab\n        if(tabId === 'dashboard') {\n            animateDashboard();\n        } else if(tabId === 'kyc') {\n            animateKYC();\n        } else {\n             gsap.from(\"#content-transactions\", {\n                opacity: 0,\n                y: 20,\n                duration: 0.5,\n                ease: \"power2.out\"\n            });\n        }\n    }\n\n    // GSAP Animations\n    function animateDashboard() {\n        gsap.from(\".gsap-blur-in\", {\n            duration: 1.2,\n            autoAlpha: 0,\n            filter: \"blur(15px)\",\n            y: 30,\n            ease: \"power4.out\"\n        });\n\n        gsap.from(\".gsap-fade-up\", {\n            duration: 0.8,\n            autoAlpha: 0,\n            y: 40,\n            stagger: 0.15,\n            ease: \"power3.out\",\n            delay: 0.3\n        });\n    }\n\n    function animateKYC() {\n        gsap.from(\"#content-kyc\", {\n            duration: 0.8,\n            autoAlpha: 0,\n            scale: 0.98,\n            ease: \"power2.out\"\n        });\n    }\n\n    // Action Handlers (Placeholder for Backend)\n    function handleAction(type) {\n        let amount = 0;\n        let isValid = false;\n        \n        if (type === 'deposit') {\n            amount = document.getElementById('deposit-amount').value;\n            isValid = amount > 0;\n            if (isValid) {\n                showNotification('success', `Successfully deposited $${amount}. Your balance is being updated.`);\n                document.getElementById('deposit-amount').value = '';\n                // Fake balance update logic\n                const currentBalance = parseFloat(document.getElementById('balance-display').innerText.replace('$', '').replace(',', ''));\n                const newBalance = (currentBalance + parseFloat(amount)).toLocaleString(undefined, {minimumFractionDigits: 2});\n                document.getElementById('balance-display').innerText = `$${newBalance}`;\n            } else {\n                showNotification('error', 'Please enter a valid deposit amount.');\n            }\n        } else if (type === 'withdraw') {\n            amount = document.getElementById('withdraw-amount').value;\n            const currentBalance = parseFloat(document.getElementById('balance-display').innerText.replace('$', '').replace(',', ''));\n            isValid = amount > 0 && amount <= currentBalance;\n            \n            if (isValid) {\n                showNotification('success', `Withdrawal of $${amount} initiated successfully.`);\n                document.getElementById('withdraw-amount').value = '';\n                const newBalance = (currentBalance - parseFloat(amount)).toLocaleString(undefined, {minimumFractionDigits: 2});\n                document.getElementById('balance-display').innerText = `$${newBalance}`;\n            } else if (amount > currentBalance) {\n                showNotification('error', 'Insufficient funds for this withdrawal.');\n            } else {\n                showNotification('error', 'Please enter a valid amount.');\n            }\n        } else if (type === 'kyc') {\n            const docType = document.getElementById('kyc-doc-type').value;\n            if (docType) {\n                showNotification('success', `Documents for ${docType} have been submitted for verification.`);\n            } else {\n                showNotification('error', 'Please select a document type before uploading.');\n            }\n        }\n    }\n\n    // Notification System using anime.js\n    function showNotification(type, message) {\n        const stack = document.getElementById('notification-stack');\n        const id = 'notif-' + Date.now();\n        const colorClass = type === 'success' ? 'bg-green-500' : 'bg-red-500';\n        const icon = type === 'success' ? 'ti-circle-check' : 'ti-alert-circle';\n        \n        const notif = document.createElement('div');\n        notif.id = id;\n        notif.className = `flex items-center gap-4 p-4 rounded-2xl bg-[#002850] border border-white/10 shadow-2xl text-white pointer-events-auto overflow-hidden relative`;\n        notif.innerHTML = `\n            <div class=\"absolute left-0 top-0 bottom-0 w-1.5 ${colorClass}\"></div>\n            <div class=\"w-10 h-10 rounded-xl ${colorClass}/20 flex items-center justify-center text-white\">\n                <i class=\"ti ${icon} text-xl\"></i>\n            </div>\n            <div class=\"flex-1 pr-4\">\n                <p class=\"text-sm font-black uppercase tracking-widest ${type === 'success' ? 'text-green-400' : 'text-red-400'}\">${type}</p>\n                <p class=\"text-xs font-medium text-white/60 leading-relaxed\">${message}</p>\n            </div>\n            <button onclick=\"this.parentElement.remove()\" class=\"text-white/20 hover:text-white transition-colors\">\n                <i class=\"ti ti-x\"></i>\n            </button>\n        `;\n        \n        stack.appendChild(notif);\n        \n        // Anime Entrance\n        anime({\n            targets: notif,\n            translateY: [-20, 0],\n            opacity: [0, 1],\n            scale: [0.95, 1],\n            duration: 400,\n            easing: 'easeOutElastic(1, .8)'\n        });\n        \n        // Auto remove after 5s\n        setTimeout(() => {\n            if (document.getElementById(id)) {\n                anime({\n                    targets: notif,\n                    translateX: [0, 100],\n                    opacity: 0,\n                    duration: 300,\n                    easing: 'easeInQuad',\n                    complete: () => notif.remove()\n                });\n            }\n        }, 5000);\n    }\n\n    // Init\n    window.onload = () => {\n        animateDashboard();\n    };\n</script>\n",
      "comments": [],
      "created": "2026-07-30T14:56:29.169473+00:00",
      "modified": "2026-07-30T14:56:29.169473+00:00",
      "id": "var_ef77fe622abd"
    },
    "var_4229fe6666d0": {
      "type": "variant",
      "label": "Blueprint Academic Tabs",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"min-h-screen bg-[#F7F7F7] font-['Overpass'] text-[#111111] flex flex-col selection:bg-[#1560BD]/20 selection:text-[#1560BD] relative overflow-x-clip\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Blueprint Grid Overlay -->\n    <div class=\"fixed inset-0 pointer-events-none opacity-[0.015] z-0 bg-[linear-gradient(to_right,#1560BD_1px,transparent_1px),linear-gradient(to_bottom,#1560BD_1px,transparent_1px)] bg-[size:40px_40px]\" data-kid=\"1-1\" data-name=\"blueprint grid overlay\">\n    </div>\n    <!-- Masthead -->\n    <header class=\"bg-[#1560BD] text-white py-6 px-8 sticky top-0 z-50 shadow-lg\" data-kid=\"1-2\" data-name=\"masthead header\">\n        <div class=\"max-w-7xl mx-auto flex items-center justify-between\" data-kid=\"1-2-1\" data-name=\"masthead container\">\n            <div class=\"flex items-center gap-4 group cursor-default\" data-kid=\"1-2-1-1\" data-name=\"brand logo and title group\">\n                <div class=\"bg-white/10 p-2 border border-white/20\" data-kid=\"1-2-1-1-1\" data-name=\"bank icon container\">\n                    <i class=\"ti ti-building-bank text-3xl\" data-kid=\"1-2-1-1-1-1\" data-name=\"bank building icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-1-1-2\" data-name=\"brand text container\">\n                    <h1 class=\"font-['Schibsted_Grotesk'] text-2xl font-black tracking-tighter leading-none\" data-kid=\"1-2-1-1-2-1\" data-name=\"bank name headline\">\n                        ABC BANK\n                    </h1>\n                    <p class=\"text-[10px] uppercase tracking-[0.3em] font-bold opacity-70\" data-kid=\"1-2-1-1-2-2\" data-name=\"bank portal description\">\n                        Academic Finance Portal\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-8 text-xs font-bold uppercase tracking-widest hidden md:flex\" data-kid=\"1-2-1-2\" data-name=\"navigation link group\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-1\" data-name=\"system status indicator group\">\n                    <span class=\"w-2 h-2 rounded-full bg-green-400 animate-pulse\" data-kid=\"1-2-1-2-1-1\" data-name=\"system status pulse indicator\">\n                    </span>\n                    System Online\n                </div>\n                <div class=\"h-4 w-px bg-white/20\" data-kid=\"1-2-1-2-2\" data-name=\"divider bar\">\n                </div>\n                <div class=\"hover:text-white/80 transition-colors cursor-pointer\" data-kid=\"1-2-1-2-3\" data-name=\"support button\">\n                    Support\n                </div>\n                <div class=\"hover:text-white/80 transition-colors cursor-pointer\" data-kid=\"1-2-1-2-4\" data-name=\"logout button\">\n                    Logout\n                </div>\n            </div>\n        </div>\n    </header>\n    <!-- Navigation Tabs -->\n    <nav class=\"bg-white border-b border-[#1560BD]/10 sticky top-[88px] z-40\" data-kid=\"1-3\" data-name=\"main navigation bar\">\n        <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"1-3-1\" data-name=\"navigation container\">\n            <ul class=\"flex gap-12\" data-kid=\"1-3-1-1\" data-name=\"navigation tabs list\" id=\"main-tabs\">\n                <li class=\"tab-btn active group py-5 relative cursor-pointer\" data-kid=\"1-3-1-1-1\" data-name=\"dashboard tab button\" data-tab=\"dashboard\">\n                    <span class=\"flex items-center gap-2 text-sm font-black uppercase tracking-widest text-[#111111]/40 group-[.active]:text-[#1560BD] hover:text-[#1560BD] transition-colors\" data-kid=\"1-3-1-1-1-1\" data-name=\"dashboard tab label\">\n                        <i class=\"ti ti-layout-dashboard text-lg\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"dashboard icon\">\n                        </i>\n                        Dashboard\n                    </span>\n                    <div class=\"absolute bottom-0 left-0 w-full h-1 bg-[#1560BD] opacity-0 group-[.active]:opacity-100 transition-opacity\" data-kid=\"1-3-1-1-1-2\" data-name=\"active tab indicator\">\n                    </div>\n                </li>\n                <li class=\"tab-btn group py-5 relative cursor-pointer\" data-kid=\"1-3-1-1-2\" data-name=\"transactions tab button\" data-tab=\"transactions\">\n                    <span class=\"flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-[#111111]/40 group-[.active]:text-[#1560BD] hover:text-[#111111] transition-colors\" data-kid=\"1-3-1-1-2-1\" data-name=\"transactions tab label\">\n                        <i class=\"ti ti-receipt text-lg\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"transactions icon\">\n                        </i>\n                        Transactions\n                    </span>\n                    <div class=\"absolute bottom-0 left-0 w-full h-1 bg-[#1560BD] opacity-0 group-[.active]:opacity-100 transition-opacity\" data-kid=\"1-3-1-1-2-2\" data-name=\"active tab indicator\">\n                    </div>\n                </li>\n                <li class=\"tab-btn group py-5 relative cursor-pointer\" data-kid=\"1-3-1-1-3\" data-name=\"kyc documentation tab button\" data-tab=\"kyc\">\n                    <span class=\"flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-[#111111]/40 group-[.active]:text-[#1560BD] hover:text-[#111111] transition-colors\" data-kid=\"1-3-1-1-3-1\" data-name=\"kyc tab label\">\n                        <i class=\"ti ti-file-text text-lg\" data-kid=\"1-3-1-1-3-1-1\" data-name=\"kyc icon\">\n                        </i>\n                        KYC Documentation\n                    </span>\n                    <div class=\"absolute bottom-0 left-0 w-full h-1 bg-[#1560BD] opacity-0 group-[.active]:opacity-100 transition-opacity\" data-kid=\"1-3-1-1-3-2\" data-name=\"active tab indicator\">\n                    </div>\n                </li>\n            </ul>\n        </div>\n    </nav>\n    <!-- Main Content Area -->\n    <main class=\"flex-grow max-w-7xl mx-auto w-full p-8 md:p-12\" data-kid=\"1-4\" data-name=\"main content area\">\n        <!-- DASHBOARD SECTION -->\n        <section class=\"content-section block space-y-20\" data-kid=\"1-4-1\" data-name=\"dashboard section\" id=\"section-dashboard\">\n            <!-- Balance Area -->\n            <div class=\"flex flex-col md:flex-row md:items-end justify-between gap-8 pb-12 border-b border-[#1560BD]/20\" data-kid=\"1-4-1-1\" data-name=\"balance area\">\n                <div class=\"space-y-6\" data-kid=\"1-4-1-1-1\" data-name=\"balance label and value container\">\n                    <h3 class=\"text-xs font-black uppercase tracking-[0.2em] text-[#1560BD]\" data-kid=\"1-4-1-1-1-1\" data-name=\"available assets label\">\n                        Available Liquid Assets\n                    </h3>\n                    <div class=\"flex items-baseline gap-3\" data-kid=\"1-4-1-1-1-2\" data-name=\"balance amount container\">\n                        <span class=\"text-4xl font-light text-[#111111]/40\" data-kid=\"1-4-1-1-1-2-1\" data-name=\"dollar symbol text\">\n                            $\n                        </span>\n                        <h2 class=\"text-7xl md:text-8xl font-black font-['Schibsted_Grotesk'] tracking-tighter text-[#111111]\" data-dynamic=\"true\" data-kid=\"1-4-1-1-1-2-2\" data-name=\"balance amount value\" data-reason=\"text updated dynamically by script on transactions\" id=\"display-balance\">\n                            12,450.80\n                        </h2>\n                    </div>\n                </div>\n                <div class=\"flex flex-col gap-2 md:text-right\" data-kid=\"1-4-1-1-2\" data-name=\"last updated info container\">\n                    <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#111111]/40\" data-kid=\"1-4-1-1-2-1\" data-name=\"last updated label\">\n                        Last Updated\n                    </span>\n                    <span class=\"text-sm font-mono font-bold\" data-kid=\"1-4-1-1-2-2\" data-name=\"last updated timestamp text\">\n                        JULY 30, 2026 — 14:55:00\n                    </span>\n                </div>\n            </div>\n            <!-- KYC Status Strip -->\n            <div class=\"bg-white border border-[#1560BD]/20 p-8 flex flex-col md:flex-row items-center justify-between gap-6 hover:shadow-[0_20px_50px_rgba(21,96,189,0.05)] transition-shadow duration-500 relative\" data-kid=\"1-4-1-2\" data-name=\"kyc status strip\">\n                <div class=\"absolute top-2 right-4 text-[9px] font-black text-[#1560BD]/40 uppercase tracking-widest\" data-kid=\"1-4-1-2-1\" data-name=\"protocol identifier text\">\n                    Protocol-449\n                </div>\n                <div class=\"flex items-center gap-8 w-full md:w-auto\" data-kid=\"1-4-1-2-2\" data-name=\"status info group\">\n                    <div class=\"w-1 h-16 bg-amber-500 shrink-0\" data-kid=\"1-4-1-2-2-1\" data-name=\"status vertical highlight bar\">\n                    </div>\n                    <div data-kid=\"1-4-1-2-2-2\" data-name=\"status text container\">\n                        <div class=\"flex items-center gap-3 mb-2\" data-kid=\"1-4-1-2-2-2-1\" data-name=\"status header container\">\n                            <span class=\"text-sm font-black uppercase tracking-widest\" data-kid=\"1-4-1-2-2-2-1-1\" data-name=\"profile status label\">\n                                Profile Status\n                            </span>\n                            <span class=\"px-3 py-1 bg-amber-100 text-amber-700 text-xs font-black uppercase rounded-xs\" data-kid=\"1-4-1-2-2-2-1-2\" data-name=\"action required status badge\">\n                                Action Required\n                            </span>\n                        </div>\n                        <p class=\"text-sm text-[#111111]/60 leading-relaxed max-w-lg\" data-kid=\"1-4-1-2-2-2-2\" data-name=\"kyc notification message\">\n                            Your account verification is currently at 65%. Complete your KYC documentation to unlock international transfers and higher withdrawal limits.\n                        </p>\n                    </div>\n                </div>\n                <button class=\"w-full md:w-auto px-10 py-4 bg-[#1560BD] text-white text-xs font-black uppercase tracking-[0.1em] hover:bg-[#0E4A96] transition-all cursor-pointer shadow-lg shadow-[#1560BD]/10 border border-transparent active:border-white/20\" data-kid=\"1-4-1-2-3\" data-name=\"resolve verification button\" onclick=\"switchTab('kyc')\">\n                    Resolve Verification\n                </button>\n            </div>\n            <!-- Transaction Forms Grid -->\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\" data-kid=\"1-4-1-3\" data-name=\"transaction forms grid\">\n                <!-- Deposit Form -->\n                <div class=\"bg-white border border-[#1560BD]/20 p-10 space-y-8 relative overflow-hidden group shadow-[0_4px_0_0_#1560BD]\" data-kid=\"1-4-1-3-1\" data-name=\"deposit form container\">\n                    <div class=\"absolute top-0 left-0 w-full h-1 bg-[#1560BD]/10 group-hover:bg-[#1560BD] transition-colors duration-500\" data-kid=\"1-4-1-3-1-1\" data-name=\"deposit form top accent\">\n                    </div>\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-4-1-3-1-2\" data-name=\"deposit header container\">\n                        <h4 class=\"font-['Schibsted_Grotesk'] text-2xl font-black uppercase tracking-tight\" data-kid=\"1-4-1-3-1-2-1\" data-name=\"deposit funds title\">\n                            Deposit Funds\n                        </h4>\n                        <i class=\"ti ti-arrow-down-left text-2xl text-[#1560BD]/20 group-hover:text-[#1560BD] transition-colors\" data-kid=\"1-4-1-3-1-2-2\" data-name=\"deposit icon\">\n                        <