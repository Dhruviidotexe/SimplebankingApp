on title\">\n                        Identity Verification\n                    </h3>\n                    <p class=\"text-sm font-bold text-[#1560BD]/60 uppercase tracking-widest\" data-kid=\"1-4-3-1-1-2\" data-name=\"governing body text\">\n                        Global Compliance Control Board\n                    </p>\n                </div>\n                <div class=\"px-6 py-2 bg-amber-500 text-white font-black text-[10px] uppercase tracking-[0.3em] flex items-center gap-3\" data-kid=\"1-4-3-1-2\" data-name=\"kyc pending status badge\">\n                    <i class=\"ti ti-loader-2 animate-spin\" data-kid=\"1-4-3-1-2-1\" data-name=\"pending loader icon\">\n                    </i>\n                    Pending Approval\n                </div>\n            </div>\n            <div class=\"grid grid-cols-12 gap-8\" data-kid=\"1-4-3-2\" data-name=\"kyc content grid\">\n                <!-- Upload Form -->\n                <div class=\"col-span-12 bg-white border border-[#1560BD]/10 p-10 space-y-8 relative shadow-xl\" data-kid=\"1-4-3-2-1\" data-name=\"kyc upload form container\">\n                    <div class=\"flex items-center gap-3 mb-2\" data-kid=\"1-4-3-2-1-1\" data-name=\"form header\">\n                        <i class=\"ti ti-upload text-[#1560BD] text-xl\" data-kid=\"1-4-3-2-1-1-1\" data-name=\"upload icon\">\n                        </i>\n                        <h4 class=\"text-xs font-black uppercase tracking-[0.3em] text-[#111111]\" data-kid=\"1-4-3-2-1-1-2\" data-name=\"upload title\">\n                            Secure Document Intake\n                        </h4>\n                    </div>\n                    <!-- Alert Placeholder -->\n                    <div class=\"hidden\" data-dynamic=\"true\" data-kid=\"1-4-3-2-1-2\" data-name=\"kyc alert container\" data-reason=\"alert visibility and content toggled by script\" id=\"kyc-alert\">\n                        <div class=\"bg-[#f0fdf4] border-l-4 border-l-[#16a34a] border border-[#bbf7d0