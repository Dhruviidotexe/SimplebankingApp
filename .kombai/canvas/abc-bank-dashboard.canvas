r to inspect verification metadata and status parameters.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"hidden w-full text-left space-y-8 animate-in fade-in zoom-in duration-300\" data-dynamic=\"true\" data-kid=\"1-4-3-2-3-3\" data-name=\"detail content container\" data-reason=\"content updated dynamically when selecting a record\" id=\"kyc-detail-content\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-4-3-2-3-3-1\" data-name=\"detail header\">\n                            <h5 class=\"text-2xl font-black uppercase tracking-tight\" data-kid=\"1-4-3-2-3-3-1-1\" data-name=\"detail title\" id=\"detail-title\">\n                                PAN Card Detail\n                            </h5>\n                            <span class=\"px-4 py-1 bg-green-500 text-white text-[9px] font-black uppercase tracking-[0.2em]\" data-kid=\"1-4-3-2-3-3-1-2\" data-name=\"detail status badge\" id=\"detail-status\">\n                                Verified\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-12\" data-kid=\"1-4-3-2-3-3-2\" data-name=\"detail grid\">\n                            <div class=\"space-y-2\" data-kid=\"1-4-3-2-3-3-2-1\" data-name=\"ref group\">\n                                <label class=\"text-[9px] font-black uppercase text-[#111111]/40 tracking-widest\" data-kid=\"1-4-3-2-3-3-2-1-1\" data-name=\"ref label\">\n                                    Global Reference\n                                </label>\n                                <p class=\"text-sm font-mono font-bold\" data-kid=\"1-4-3-2-3-3-2-1-2\" data-name=\"ref value\" id=\"detail-ref\">\n                                    REF-PAN-9920-X\n                                </p>\n                            </div>\n                            <div class=\"space-y-2\" data-kid=\"1-4-3-2-3-3-2-2\" data-name=\"date group\">\n                                <label class=\"text-[9px] font-black uppercase text-[#111111]/40 tracking-widest\" data-kid=\"1-4-3-2-3-3-2-2-1\" data-name=\"date label\">\n                                    Entry Date\n                                </label>\n                                <p class=\"text-sm font-mono font-bold\" data-kid=\"1-4-3-2-3-3-2-2-2\" data-name=\"date value\" id=\"detail-date\">\n                                    2026-07-20 09:44:12\n                                </p>\n                            </div>\n                            <div class=\"col-span-2 space-y-2\" data-kid=\"1-4-3-2-3-3-2-3\" data-name=\"notes group\">\n                                <label class=\"text-[9px] font-black uppercase text-[#111111]/40 tracking-widest\" data-kid=\"1-4-3-2-3-3-2-3-1\" data-name=\"notes label\">\n                                    Inspector Notes\n                                </label>\n                                <p class=\"text-xs text-[#111111]/70 bg-[#F7F7F7] p-4 border border-[#1560BD]/5 italic\" data-kid=\"1-4-3-2-3-3-2-3-2\" data-name=\"notes text\">\n                                    \"Primary tax document successfully cross-referenced with centralized national database. No discrepancies found.\"\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-[#1560BD] hover:underline cursor-pointer\" data-kid=\"1-4-3-2-3-3-3\" data-name=\"view asset link\">\n                            <i class=\"ti ti-external-link\" data-kid=\"1-4-3-2-3-3-3-1\" data-name=\"external icon\">\n                            </i>\n                            View Original Asset\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <!-- Footer -->\n    <footer class=\"bg-white border-t border-[#1560BD]/10 py-10 px-8 mt-12\" data-kid=\"1-5\" data-name=\"footer bar\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"1-5-1\" data-name=\"footer content container\">\n            <div class=\"flex items-center gap-4 opacity-40\" data-kid=\"1-5-1-1\" data-name=\"footer logo group\">\n                <i class=\"ti ti-building-bank text-2xl\" data-kid=\"1-5-1-1-1\" data-name=\"footer logo icon\">\n                </i>\n                <span class=\"text-xs font-black tracking-[0.3em] uppercase\" data-kid=\"1-5-1-1-2\" data-name=\"footer brand text\">\n                    ABC Bank Systems\n                </span>\n            </div>\n            <div class=\"text-[10px] font-black text-[#111111]/40 uppercase tracking-[0.2em] text-center border border-[#1560BD]/10 px-6 py-2\" data-kid=\"1-5-1-2\" data-name=\"copyright notice text\">\n                © 2026 ABC Bank. Educational Project.\n            </div>\n            <div class=\"flex gap-6\" data-kid=\"1-5-1-3\" data-name=\"social media links group\">\n                <i class=\"ti ti-brand-twitter text-[#1560BD] text-lg cursor-pointer hover:scale-110 transition-transform\" data-kid=\"1-5-1-3-1\" data-name=\"twitter link\">\n                </i>\n                <i class=\"ti ti-brand-linkedin text-[#1560BD] text-lg cursor-pointer hover:scale-110 transition-transform\" data-kid=\"1-5-1-3-2\" data-name=\"linkedin link\">\n                </i>\n                <i class=\"ti ti-brand-github text-[#1560BD] text-lg cursor-pointer hover:scale-110 transition-transform\" data-kid=\"1-5-1-3-3\" data-name=\"github link\">\n                </i>\n            </div>\n        </div>\n    </footer>\n</div>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&family=Overpass:ital,wght@0,100..900;1,100..900&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.tab-btn.active span {\n    color: #1560BD;\n}\n\n/* Chrome, Safari, Edge, Opera */\ninput::-webkit-outer-spin-button,\ninput::-webkit-inner-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\n\n/* Firefox */\ninput[type=number] {\n  -moz-appearance: textfield;\n}\n\n.content-section {\n    will-change: transform, opacity;\n}\n\nbody {\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n}\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    // Initial State\n    let currentBalance = 12450.80;\n\n    // --- TAB SWITCHING LOGIC ---\n    const tabButtons = document.querySelectorAll('.tab-btn');\n    const sections = document.querySelectorAll('.content-section');\n\n    function switchTab(tabId) {\n        // Update Buttons\n        tabButtons.forEach(btn => {\n            if(btn.dataset.tab === tabId) btn.classList.add('active');\n            else btn.classList.remove('active');\n        });\n\n        // GSAP transition for sections\n        const currentActive = document.querySelector('.content-section:not(.hidden)');\n        const targetSection = document.getElementById(`section-${tabId}`);\n\n        if (currentActive === targetSection) return;\n\n        gsap.to(currentActive, {\n            opacity: 0,\n            y: 20,\n            duration: 0.3,\n            onComplete: () => {\n                currentActive.classList.add('hidden');\n                targetSection.classList.remove('hidden');\n                \n                gsap.fromTo(targetSection, \n                    { opacity: 0, y: 20 },\n                    { opacity: 1, y: 0, duration: 0.5, ease: \"power2.out\" }\n                );\n            }\n        });\n    }\n\n    tabButtons.forEach(btn => {\n        btn.addEventListener('click', () => switchTab(btn.dataset.tab));\n    });\n\n    // --- DASHBOARD ACTIONS ---\n\n    function setAmount(type, value) {\n        document.getElementById(`${type}-amount`).value = value.toFixed(2);\n    }\n\n    function handleDeposit() {\n        const amountInput = document.getElementById('deposit-amount');\n        const amount = parseFloat(amountInput.value);\n        const alert = document.getElementById('deposit-alert');\n\n        if (!amount || amount <= 0) return;\n\n        // Simulate logic\n        currentBalance += amount;\n        updateBalanceDisplay();\n        \n        // Success Alert Animation\n        alert.classList.remove('hidden');\n        gsap.from(alert, { height: 0, opacity: 0, duration: 0.4, ease: \"back.out(1.7)\" });\n        \n        // Reset and hide alert after delay\n        amountInput.value = '';\n        setTimeout(() => {\n            gsap.to(alert, { opacity: 0, height: 0, duration: 0.3, onComplete: () => alert.classList.add('hidden') });\n        }, 5000);\n\n        // Add to history (visual only)\n        addTransactionRow('Deposit', amount, 'CREDIT_DEPOSIT_PORTAL');\n    }\n\n    function handleWithdraw() {\n        const amountInput = document.getElementById('withdraw-amount');\n        const amount = parseFloat(amountInput.value);\n        const alert = document.getElementById('withdraw-alert');\n\n        if (!amount || amount <= 0) return;\n\n        if (amount > currentBalance) {\n            // Show Error\n            alert.classList.remove('hidden');\n            gsap.from(alert, { x: -20, opacity: 0, duration: 0.4, ease: \"elastic.out(1, 0.3)\" });\n            \n            setTimeout(() => {\n                gsap.to(alert, { opacity: 0, duration: 0.3, onComplete: () => alert.classList.add('hidden') });\n            }, 5000);\n            return;\n        }\n\n        currentBalance -= amount;\n        updateBalanceDisplay();\n        \n        amountInput.value = '';\n        // Add to history\n        addTransactionRow('Withdraw', -amount, 'DEBIT_WITHDRAW_PORTAL');\n    }\n\n    function updateBalanceDisplay() {\n        const display = document.getElementById('display-balance');\n        gsap.to({}, {\n            duration: 1,\n            onUpdate: function() {\n                display.innerText = currentBalance.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n            }\n        });\n    }\n\n    // --- TRANSACTION LOGIC ---\n\n    function addTransactionRow(type, amount, msg) {\n        const tbody = document.getElementById('transaction-rows');\n        const date = new Date().toISOString().split('T')[0];\n        const isDeposit = amount > 0;\n        \n        const tr = document.createElement('tr');\n        tr.className = \"border-b border-[#1560BD]/5 hover:bg-[#F7F7F7] transition-colors group opacity-0\";\n        tr.innerHTML = `\n            <td class=\"p-6 border-r border-[#1560BD]/5 font-mono text-[#111111]/60\">${date}</td>\n            <td class=\"p-6 border-r border-[#1560BD]/5\"><span class=\"px-2 py-1 ${isDeposit ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'} font-black text-[9px] uppercase tracking-tighter\">${type.toUpperCase()}</span></td>\n            <td class=\"p-6 border-r border-[#1560BD]/5 text-right font-black ${isDeposit ? 'text-green-600' : 'text-red-600'}\">${isDeposit ? '+' : ''}$${Math.abs(amount).toFixed(2)}</td>\n            <td class=\"p-6 border-r border-[#1560BD]/5 text-right font-bold text-[#111111]/80\">$${currentBalance.toFixed(2)}</td>\n            <td class=\"p-6 italic text-[#111111]/40 group-hover:text-[#111111]/70 transition-colors underline decoration-dotted underline-offset-4\">${msg}</td>\n        `;\n        \n        tbody.prepend(tr);\n        gsap.to(tr, { opacity: 1, duration: 0.5 });\n    }\n\n    // --- KYC LOGIC ---\n\n    function handleKYCUpload() {\n        const type = document.getElementById('kyc-type').value;\n        const number = document.getElementById('kyc-number').value;\n        const alert = document.getElementById('kyc-alert');\n\n        if (!type || !number) return;\n\n        alert.classList.remove('hidden');\n        gsap.from(alert, { scaleY: 0, opacity: 0, duration: 0.4, transformOrigin: \"top\" });\n\n        // Add to list visually\n        const list = document.getElementById('kyc-list');\n        const div = document.createElement('div');\n        div.onclick = () => selectKYCDocument(type.toLowerCase());\n        div.className = \"kyc-item bg-white border border-[#1560BD]/5 border-l-4 border-l-amber-500 p-5 flex items-center justify-between cursor-pointer hover:shadow-lg transition-all active:scale-[0.98]\";\n        div.innerHTML = `\n            <div class=\"space-y-1\">\n                <p class=\"text-sm font-black uppercase tracking-tight\">${type} Token</p>\n                <p class=\"text-[9px] uppercase font-bold text-[#111111]/40\">Queueing: 2026-07-30</p>\n            </div>\n            <div class=\"bg-amber-100 p-2 rounded-full\">\n                <i class=\"ti ti-clock-hour-4 text-amber-600\"></i>\n            </div>\n        `;\n        list.prepend(div);\n\n        document.getElementById('kyc-number').value = '';\n        setTimeout(() => {\n            gsap.to(alert, { opacity: 0, duration: 0.3, onComplete: () => alert.classList.add('hidden') });\n        }, 4000);\n    }\n\n    function selectKYCDocument(docType) {\n        const emptyState = document.getElementById('kyc-empty-state');\n        const content = document.getElementById('kyc-detail-content');\n        \n        emptyState.classList.add('hidden');\n        content.classList.remove('hidden');\n\n        // Update content based on type\n        const title = document.getElementById('detail-title');\n        const status = document.getElementById('detail-status');\n        const ref = document.getElementById('detail-ref');\n        \n        if (docType === 'pan') {\n            title.innerText = 'PAN Card Detail';\n            status.innerText = 'Verified';\n            status.className = 'px-4 py-1 bg-green-500 text-white text-[9px] font-black uppercase tracking-[0.2em]';\n            ref.innerText = 'REF-PAN-9920-X';\n        } else if (docType === 'aadhaar') {\n            title.innerText = 'Aadhaar Card Detail';\n            status.innerText = 'Pending Review';\n            status.className = 'px-4 py-1 bg-amber-500 text-white text-[9px] font-black uppercase tracking-[0.2em]';\n            ref.innerText = 'REF-AAD-4481-Q';\n        } else {\n            title.innerText = `${docType.toUpperCase()} Detail`;\n            status.innerText = 'In Queue';\n            status.className = 'px-4 py-1 bg-gray-400 text-white text-[9px] font-black uppercase tracking-[0.2em]';\n            ref.innerText = 'REF-TEMP-0000-0';\n        }\n\n        gsap.from(content, { opacity: 0, x: 20, duration: 0.4 });\n    }\n\n    // Initial load animation\n    window.addEventListener('load', () => {\n        gsap.from('.content-section', { opacity: 0, y: 30, duration: 0.8, ease: \"power3.out\" });\n        gsap.from('header', { y: -100, duration: 0.8, ease: \"power4.out\" });\n        gsap.from('.tab-btn', { opacity: 0, stagger: 0.1, duration: 0.5, delay: 0.5 });\n    });\n</script>\n",
